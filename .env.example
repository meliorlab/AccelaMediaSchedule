# --- Supabase / Postgres ---
# From your Supabase project: Project Settings -> Database -> Connection string.
# For Vercel (serverless) use the "Transaction" pooler string (host ends in
# ...pooler.supabase.com, port 6543). Set this in the Vercel project's
# Environment Variables, and in server/.env for local development.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
