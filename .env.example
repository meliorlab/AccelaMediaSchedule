# --- Database (production / Vercel) ---
# Create a free libSQL database at https://turso.tech, then set these in the
# Vercel project's Environment Variables. Leave them unset locally to use an
# on-disk SQLite file (server/data/media-schedules.db) for `npm run dev`.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token

# Optional: override the local SQLite file location (ignored when TURSO_DATABASE_URL is set).
# DATA_DIR=./server/data
